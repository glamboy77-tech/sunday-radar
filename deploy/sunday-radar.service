[Unit]
Description=Generate the Sunday Radar weekly briefing
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/data/projects/sunday-radar
EnvironmentFile=-/data/projects/sunday-radar/.env
Environment=GIT_TERMINAL_PROMPT=0
Environment="GIT_SSH_COMMAND=ssh -o BatchMode=yes -o ConnectTimeout=20"
ExecStart=/bin/bash /data/projects/sunday-radar/deploy/run-weekly.sh
Restart=on-failure
RestartSec=15min
TimeoutStartSec=30min
UMask=0077

# Install with: bash /data/projects/sunday-radar/deploy/install.sh