<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="정치·정책과 시장·생활의 연결을 읽는 주간 브리핑">
  <title>Sunday Radar — {{ brief.week_ending }}</title>
  <link rel="stylesheet" href="{{ '/sunday-radar/assets/style.css' }}">
</head>
<body>
  <header class="masthead">
    <div class="shell">
      <a class="brand" href="/sunday-radar/">SUNDAY RADAR</a>
      <a class="archive-link" href="/sunday-radar/archive.html">지난 브리핑</a>
    </div>
  </header>
  <main class="shell">
    <section class="hero">
      <p class="edition">{{ brief.week_ending }} · 약 {{ brief.reading_minutes }}분 · 핵심 이슈 {{ brief.issues | length }}개 · 데이터 소스 {{ brief.source_kinds | length }}종</p>
      <p class="hero-label">이번 주의 이야기</p>
      <h1>{{ editorial.headline if editorial else brief.headline }}</h1>
      <p class="lede">{{ editorial.overview if editorial else brief.overview }}</p>
      {% if brief.missing_days %}<p class="notice">입력 누락일: {{ brief.missing_days | join(', ') }}</p>{% endif %}
    </section>

    <section class="story" aria-labelledby="board-title">
      <div class="section-heading"><p>THE WEEKLY STORY</p><h2 id="board-title">이번 주, 판을 바꾼<br>세 개의 장면</h2></div>
      {% for issue in brief.issues %}
      {% set editorial_section = editorial.sections[loop.index0] if editorial else none %}
      <article class="issue-card issue-card-{{ issue.editorial_lens.value }}" id="issue-{{ loop.index }}">
        <p class="chapter-kicker">{{ lens_labels[issue.editorial_lens.value] }}{% if issue.editorial_lens.value == 'game_changer' %} · 주간 하이라이트{% endif %}</p>
        <div class="issue-number"><b>{{ '%02d' | format(loop.index) }}</b><span>{{ issue.category }}</span></div>
        <h3>{{ editorial_section.heading if editorial_section else issue.title }}</h3>
        <div class="story-copy">
          {% if editorial_section %}
          {% for paragraph in editorial_section.paragraphs %}
          <p class="story-paragraph story-paragraph-{{ paragraph.kind.value }}">{{ paragraph.text }}</p>
          {% endfor %}
          {% else %}
          {% for block in issue.blocks %}
          <p class="story-paragraph story-paragraph-{{ block.kind.value }}">{{ block.text }}</p>
          {% endfor %}
          {% endif %}
        </div>
        {% if issue.sources %}<div class="sources"><h4>함께 읽을 자료</h4><ul>{% for source in issue.sources %}<li><a href="{{ source.url }}" rel="noopener noreferrer">{{ source.title }}</a><small>{{ source.source }}{% if source.source_kind == 'bank_of_korea' %} · 공식 자료{% endif %}</small></li>{% endfor %}</ul></div>{% endif %}
      </article>
      {% if not loop.last %}<p class="story-transition">{{ editorial.transitions[loop.index0] if editorial else transitions[loop.index0] }}</p>{% endif %}
      {% else %}<p>분석 가능한 핵심 이슈가 없습니다.</p>{% endfor %}
      {% if editorial %}<p class="story-conclusion">{{ editorial.conclusion }}</p>{% endif %}
    </section>

    {% if brief.official_updates %}
    <section aria-labelledby="official-title">
      <div class="section-heading secondary"><p>ECONOMY IN PLAIN WORDS</p><h2 id="official-title">한국은행 숫자를<br>생활 언어로 읽기</h2></div>
      <p class="section-intro">생활비와 경기 감각을 읽는 데 바로 도움이 되는 공식 지표만 골라 뜻을 풀었습니다.</p>
      <div class="reading-notes">
      {% for issue in brief.official_updates %}
        <article>
          <p class="current-meta">{{ issue.sources[0].source }} · {{ issue.last_seen }}</p>
          <h3>{{ issue.reader_heading }}</h3>
          <p>{{ issue.reader_summary }}</p>
          <a class="text-link" href="{{ issue.sources[0].url }}" rel="noopener noreferrer">공식 원문 읽기 →</a>
        </article>
      {% endfor %}
      </div>
    </section>
    {% endif %}

    <section aria-labelledby="currents-title">
      <div class="section-heading secondary"><p>EXTRA RADAR</p><h2 id="currents-title">본편 밖에서도<br>놓치면 안 될 변화</h2></div>
      <p class="section-intro">본편의 세 축에는 들지 않았지만, 현장과 생활의 조건을 바꿀 가능성이 남은 소식입니다.</p>
      <div class="reading-notes">
      {% for issue in brief.currents %}
        <article>
          <p class="current-meta">{{ issue.category }} · {{ lens_labels[issue.editorial_lens.value] }}</p>
          <h3>{{ issue.title }}</h3>
          <p>{{ (issue.sources[0].description or issue.blocks[0].text or issue.sources[0].title) | truncate(320, true, '…') }}</p>
          <div class="current-links">
          {% for source in issue.sources[:2] %}
            <a class="text-link" href="{{ source.url }}" rel="noopener noreferrer">{{ source.title | truncate(72, true, '…') }} <small>{{ source.source }}</small> →</a>
          {% endfor %}
          </div>
        </article>
      {% else %}<p>이번 주에는 기준을 충족한 별도 흐름이 없습니다.</p>{% endfor %}
      </div>
    </section>

    <aside class="method"><strong>이 브리핑을 읽는 법</strong><p>{{ brief.methodology_note }}{% if editorial %} 본문은 선택된 근거 범위 안에서 LLM의 문장 편집을 거쳤으며, 출처 ID와 숫자 검사를 통과한 원고만 사용합니다.{% endif %}</p></aside>
  </main>
  <footer><div class="shell"><a href="/sunday-radar/archive.html">지난 브리핑 보기</a><span>Sunday Radar</span></div></footer>
</body>
</html>